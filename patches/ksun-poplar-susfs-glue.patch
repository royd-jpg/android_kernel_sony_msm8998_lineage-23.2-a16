+config KSU_SUSFS
+	bool "KernelSU addon - SUSFS (fs/susfs.c kernel core)"
+	depends on KSU && KSU != m
+	depends on THREAD_INFO_IN_TASK
+	default n
+	help
+	  Wire the in-tree SUSFS core (fs/susfs.c, include/linux/susfs.h) to
+	  KernelSU-Next: reboot-syscall command dispatch, susfs_init(),
+	  susfs_is_current_ksu_domain() and the post-umount work item.
+	  The kernel core itself must already be in the tree.
+
+config KSU_SUSFS_SUS_PATH
+	bool "SUSFS sus_path (userspace commands only unless the kernel has call sites)"
+	depends on KSU_SUSFS
