+
+config KSU_SUSFS_SUS_MOUNT
+	bool "SUSFS sus_mount (fs/namespace.c hunks)"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_SUS_KSTAT
+	bool "SUSFS sus_kstat"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_TRY_UMOUNT
+	bool "SUSFS try_umount (alias of KernelSU-Next kernel_umount in this port)"
+	depends on KSU_SUSFS
+	default n
+	help
+	  SUSFS v2.3.0 has no separate try_umount list in the kernel core
+	  (CMD_SUSFS_ADD_TRY_UMOUNT is deprecated). This option routes the
+	  setresuid umount through susfs_try_umount(), which calls the
+	  KernelSU-Next ksu_handle_umount() unchanged.
+
+config KSU_SUSFS_SPOOF_UNAME
+	bool "SUSFS spoof_uname"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_ENABLE_LOG
+	bool "SUSFS kernel logging"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+	bool "SUSFS kallsyms symbol hiding (no kernel implementation in this port)"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	bool "SUSFS spoof /proc/cmdline"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_OPEN_REDIRECT
+	bool "SUSFS open_redirect"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_SUS_MAP
+	bool "SUSFS sus_map"
