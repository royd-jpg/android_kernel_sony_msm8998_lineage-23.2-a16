diff --git a/kernel/Kconfig b/kernel/Kconfig
index 946966dc..1e821798 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -73,3 +73,70 @@ config KSU_SYSCALL_TABLE_HOOK
